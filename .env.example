# OAuth 2.0 confidential client from the X Developer Console
# App settings → User authentication settings
# Callback URL must include:
#   http://localhost:3000/api/auth/callback
#   https://<your-vercel-host>/api/auth/callback
# App permissions / scopes used: tweet.read users.read dm.read dm.write offline.access

X_CLIENT_ID=
X_CLIENT_SECRET=

# Optional. Defaults to {request origin}/api/auth/callback
# X_REDIRECT_URI=https://your-app.vercel.app/api/auth/callback

# Optional. Used to encrypt the login cookie. Falls back to X_CLIENT_SECRET.
# SESSION_SECRET=
