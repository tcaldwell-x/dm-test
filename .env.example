# OAuth 1.0a consumer keys from the X Developer Console
# App settings → User authentication settings → OAuth 1.0a
# App permissions: Read and write and Direct message
# Callback URL must include:
#   http://localhost:3000/api/auth/callback
#   https://<your-vercel-host>/api/auth/callback

X_API_KEY=
X_API_SECRET=

# Optional. Defaults to {request origin}/api/auth/callback
# X_REDIRECT_URI=https://your-app.vercel.app/api/auth/callback

# Optional. Used to encrypt the login cookie. Falls back to X_API_SECRET.
# SESSION_SECRET=
